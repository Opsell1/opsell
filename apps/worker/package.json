{
  "name": "@opsell/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opsell/core": "workspace:*",
    "@opsell/db": "workspace:*",
    "pg-boss": "12.37.0"
  },
  "devDependencies": {
    "@opsell/config": "workspace:*",
    "@opsell/testing": "workspace:*",
    "@types/node": "24.19.1",
    "drizzle-orm": "0.45.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
