    "test": "vitest run",
    "staff": "node --env-file-if-exists=../../.env src/staff-cli.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@opsell/contract": "workspace:*",
    "@opsell/core": "workspace:*",
    "@opsell/db": "workspace:*",
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "pg-boss": "12.37.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opsell/config": "workspace:*",
    "@opsell/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "drizzle-orm": "0.45.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
