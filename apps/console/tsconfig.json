{
  "extends": "@opsell/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next/standalone"]
}
