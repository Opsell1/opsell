{
  "name": "@opsell/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts"
  },
  "scripts": {
    "bootstrap": "node --env-file-if-exists=../../.env src/admin/bootstrap-cli.ts",
    "migrate": "node --env-file-if-exists=../../.env src/admin/migrate-cli.ts",
    "seed": "node --env-file-if-exists=../../.env src/admin/seed-cli.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "pg-boss": "12.37.0"
  },
  "devDependencies": {
    "@opsell/config": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
