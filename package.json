{
  "name": "opsell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @opsell/web test:e2e",
    "db:bootstrap": "pnpm --filter @opsell/db bootstrap",
    "db:migrate": "pnpm --filter @opsell/db migrate",
    "db:seed": "pnpm --filter @opsell/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
