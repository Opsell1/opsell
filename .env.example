# Copied to .env by `pnpm dev` when .env is missing. Local development values only.

# Superuser connection, used only by `pnpm db:bootstrap` and the test harness to create
# roles and databases.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Migrations and seeds run as the owner role. The API and worker connect as roles
# without BYPASSRLS, so Row-Level Security applies to every query they make.
DATABASE_OWNER_URL=postgres://opsell_owner:opsell_owner@localhost:5432/opsell
DATABASE_API_URL=postgres://opsell_api:opsell_api@localhost:5432/opsell
DATABASE_WORKER_URL=postgres://opsell_worker:opsell_worker@localhost:5432/opsell

# Mailpit catches every email locally: http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Opsell <no-reply@opsell.localhost>"

BETTER_AUTH_SECRET=local-development-secret-change-me-0123456789
WEB_ORIGIN=http://localhost:3000
API_PORT=4000
API_URL=http://localhost:4000
