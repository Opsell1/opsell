{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "extends": ["./packages/config/biome.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!prototypes",
      "!design",
      "!.agents",
      "!.claude",
      "!skills-lock.json",
      "!**/src/generated",
      "!**/openapi.json",
      "!**/drizzle/meta",
      "!packages/ui/src/generated"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
